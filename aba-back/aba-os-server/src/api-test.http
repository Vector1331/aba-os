# ===============================================
# ABA-OS API 테스트 파일
# ===============================================
# Swagger UI 접속 URL: http://localhost:8080/swagger-ui/index.html
# OpenAPI 문서 (JSON): http://localhost:8080/v3/api-docs
# ===============================================
#
# ** 처음 테스트하는 경우 **
# ----------------------------------------
# 이 파일의 요청을 순서대로 실행하면 테스트 데이터가 자동 생성됩니다.
# 1번부터 순서대로 실행하세요!
#
# ** 테스트 계정 정보 **
# ----------------------------------------
# Admin:     admin@gmail.com / admin1234
# Therapist: therapist@gmail.com / therapist1234
# Invite Code: ABA2026
# ----------------------------------------
#
# ===============================================

### ===============================================
### [PART 1] 메인 서비스 플로우 테스트
### 순서대로 실행하세요!
### ===============================================

### -----------------------------------------------
### STEP 1: Admin 계정 생성 (회원가입)
### -----------------------------------------------
### 1-1. Admin 회원가입
# 센터장(Admin) 계정을 생성합니다.
# inviteCode는 센터 가입 시 필요한 초대 코드입니다.
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "email": "admin2@gmail.com",
  "password": "admin1234",
  "name": "센터장",
  "role": "ADMIN",
  "inviteCode": "ABA20262"
}

### 1-2. Admin 로그인
# Admin 계정으로 로그인하여 JWT 토큰을 발급받습니다.
# 이후 모든 Admin 전용 API에서 이 토큰을 사용합니다.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin2@gmail.com",
  "password": "admin1234"
}
> {%
    client.global.set("admin_token", response.body.data.accessToken);
    client.log("Admin Token saved!");
%}

### -----------------------------------------------
### STEP 2: 치료사 등록
### -----------------------------------------------
### 2-1. 치료사 사용자 회원가입 : 치료사로 등록할 사용자 계정을 먼저 생성합니다.
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "email": "therapist3@gmail.com",
  "password": "therapist1234",
  "name": "김치료3",
  "role": "THERAPIST",
  "inviteCode": "ABA20262"
}

### 2-2. 치료사 사용자 로그인 (User ID 확인용)
# 치료사 계정으로 로그인합니다.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "therapist3@gmail.com",
  "password": "therapist1234"
}
> {%
    client.global.set("therapist_token", response.body.data.accessToken);
    client.log("Therapist Token saved!");
%}

### 2-3. 치료사 사용자 정보 조회 (User ID 획득)
# 치료사의 User ID를 확인합니다.
GET http://localhost:8080/api/v1/users/me
Authorization: Bearer {{therapist_token}}

> {%
    client.global.set("therapist_user_id", response.body.data.id);
    client.log("Therapist User ID saved: " + response.body.data.id);
%}

### 2-4. 치료사 정보 조회 (User ID로 Therapist ID 획득)
# THERAPIST로 회원가입 시 Therapist 레코드가 자동 생성됩니다.
# Admin이 User ID로 치료사 정보를 조회하여 Therapist ID를 획득합니다.
GET http://localhost:8080/api/v1/therapists/by-user/{{therapist_user_id}}
Authorization: Bearer {{admin_token}}

> {%
    client.global.set("therapist_id", response.body.data.id);
    client.log("Therapist ID saved: " + response.body.data.id);
%}

### 2-5. 치료사 정보 수정 (전문분야/경력 설정)
# Admin이 치료사의 전문분야와 경력을 설정합니다.
PUT http://localhost:8080/api/v1/therapists/{{therapist_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "specialty": "ABA 치료",
  "experienceYears": 3
}

### 2-6. 치료사 목록 조회 (확인용)
GET http://localhost:8080/api/v1/therapists
Authorization: Bearer {{admin_token}}

### -----------------------------------------------
### STEP 3: 아동 등록 (Admin 권한)
### -----------------------------------------------
### 3-1. 아동 등록
# Admin이 치료 대상 아동을 등록합니다.
POST http://localhost:8080/api/v1/children
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "김철수",
  "birthDate": "2020-03-15",
  "gender": "MALE",
  "diagnosis": "자폐 스펙트럼 장애 (ASD)",
  "currentDevLevel": "언어 발달 지연, 눈 맞춤 어려움",
  "parentCharacteristics": "적극적인 가정 연계 치료 희망",
  "requestDetails": "눈 맞춤 및 호명 반응 개선",
  "therapistId": {{therapist_id}}
}
> {%
    client.global.set("child_id", response.body.data);
    client.log("Child ID saved: " + response.body.data);
%}

### -----------------------------------------------
### STEP 4: 치료사 로그인 및 아동 조회
### -----------------------------------------------
### 4-1. 치료사 로그인 (토큰 갱신)
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "therapist3@gmail.com",
  "password": "therapist1234"
}
> {%
    client.global.set("therapist_token", response.body.data.accessToken);
    client.log("Therapist Token refreshed!");
%}

### 4-2. 아동 목록 조회 (치료사)
# 치료사가 담당하는 아동 목록을 조회합니다.
GET http://localhost:8080/api/v1/children
Authorization: Bearer {{therapist_token}}

> {%
    if (response.body.data && response.body.data.length > 0) {
        client.global.set("child_id", response.body.data[0].id);
        client.log("Child ID from list: " + response.body.data[0].id);
    }
%}

### 4-3. 아동 상세 조회
GET http://localhost:8080/api/v1/children/{{child_id}}
Authorization: Bearer {{therapist_token}}

### -----------------------------------------------
### STEP 5: 목표 생성 및 조회
### -----------------------------------------------
### 5-1. 목표 생성
# 아동에 대한 치료 목표를 생성합니다.
POST http://localhost:8080/api/v1/children/{{child_id}}/goals
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "name": "이름 부르면 눈 맞추기",
  "category": "SOCIAL",
  "description": "이름을 부르면 3초 이내에 눈을 맞추는 행동 형성",
  "targetSuccessRate": 80,
  "consecutiveDays": 3,
  "promptPlan": "신체적 촉구 -> 제스처 촉구 -> 언어적 촉구 -> 독립 수행"
}
> {%
    client.global.set("goal_id", response.body.data);
    client.log("Goal ID saved: " + response.body.data);
%}

### 5-2. 목표 목록 조회
GET http://localhost:8080/api/v1/children/{{child_id}}/goals
Authorization: Bearer {{therapist_token}}

> {%
    if (response.body.data && response.body.data.length > 0) {
        client.global.set("goal_id", response.body.data[0].id);
        client.log("Goal ID from list: " + response.body.data[0].id);
    }
%}

### 5-3. 목표 상세 조회
GET http://localhost:8080/api/v1/goals/{{goal_id}}
Authorization: Bearer {{therapist_token}}

### -----------------------------------------------
### STEP 6: 세션 생성 및 조회
### -----------------------------------------------
### 6-1. 세션 생성 (시행 기록 포함)
# 치료 세션과 시행(Trial) 기록을 함께 생성합니다.
POST http://localhost:8080/api/v1/sessions
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "childId": {{child_id}},
  "therapistId": {{therapist_id}},
  "sessionDate": "2026-02-07",
  "duration": 50,
  "notes": "첫 번째 세션. 아동 컨디션 양호.",
  "trials": [
    {
      "goalId": {{goal_id}},
      "taskContent": "이름 부르고 눈 맞춤 유도",
      "trials": 10,
      "successes": 6,
      "promptCount": 3,
      "memo": "언어적 촉구에 반응 좋음"
    }
  ]
}
> {%
    client.global.set("session_id", response.body.data);
    client.log("Session ID saved: " + response.body.data);
%}

### 6-2. 추가 세션 생성 (리포트 테스트용)
POST http://localhost:8080/api/v1/sessions
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "childId": {{child_id}},
  "therapistId": {{therapist_id}},
  "sessionDate": "2026-02-05",
  "duration": 50,
  "notes": "두 번째 세션. 눈 맞춤 개선 보임.",
  "trials": [
    {
      "goalId": {{goal_id}},
      "taskContent": "이름 부르고 눈 맞춤 유도",
      "trials": 12,
      "successes": 9,
      "promptCount": 2,
      "memo": "제스처 촉구로 전환 시도"
    }
  ]
}

### 6-3. 세션 목록 조회
GET http://localhost:8080/api/v1/sessions?childId={{child_id}}
Authorization: Bearer {{therapist_token}}

### 6-4. 세션 상세 조회
GET http://localhost:8080/api/v1/sessions/{{session_id}}
Authorization: Bearer {{therapist_token}}

### -----------------------------------------------
### STEP 7: 리포트 생성 (두 가지 버전)
### -----------------------------------------------
### 7-1. AI 리포트 생성 (PARENT_SUMMARY)
# OpenAI API 키가 설정되어 있으면 AI가 부모님께 드릴 총평을 작성합니다.
# API 키가 없으면 더미 텍스트가 생성됩니다.
POST http://localhost:8080/api/v1/reports
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "childId": {{child_id}},
  "title": "2026년 2월 발달 리포트 (AI 버전)",
  "periodStart": "2026-02-01",
  "periodEnd": "2026-02-28",
  "reportType": "PARENT_SUMMARY"
}
> {%
    client.global.set("report_id", response.body.data.id);
    client.log("Report ID saved: " + response.body.data.id);
%}

### 7-2. 통계 리포트 생성 (STATISTICS_ONLY)
# AI 없이 통계 데이터만 생성합니다.
POST http://localhost:8080/api/v1/reports
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "childId": {{child_id}},
  "title": "2026년 2월 통계 리포트",
  "periodStart": "2026-02-01",
  "periodEnd": "2026-02-28",
  "reportType": "STATISTICS_ONLY"
}

### 7-3. 리포트 목록 조회
GET http://localhost:8080/api/v1/reports?childId={{child_id}}
Authorization: Bearer {{therapist_token}}

### 7-4. 리포트 상세 조회
GET http://localhost:8080/api/v1/reports/{{report_id}}
Authorization: Bearer {{therapist_token}}

### -----------------------------------------------
### STEP 8: 대시보드 조회
### -----------------------------------------------
### 8-1. 대시보드 요약 조회 (Admin)
# 센터별 활성 아동 수, 세션 수, 예정 세션 목록 등을 조회합니다.
GET http://localhost:8080/api/v1/dashboard/summary
Authorization: Bearer {{admin_token}}

### 8-2. 대시보드 요약 조회 (Therapist)
GET http://localhost:8080/api/v1/dashboard/summary
Authorization: Bearer {{therapist_token}}

### -----------------------------------------------
### STEP 9: 엑셀 마이그레이션
### -----------------------------------------------
### 9-1. 기본 엑셀 마이그레이션 (Children + Goals)
# Sheet 1: Children (Name, BirthDate, Gender, Diagnosis)
# Sheet 2: Goals (ChildName, GoalContent, Category)
POST http://localhost:8080/api/v1/migration/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{admin_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="migration_data.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./test-data/migration_data.xlsx
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 9-2. DIA 템플릿 엑셀 마이그레이션
# DIA 템플릿 형식의 세션/시행 기록 마이그레이션
# V3: 아동명, V4: 날짜, C열: 과제내용, H~Q열: 시행 마커(+/-/p)
POST http://localhost:8080/api/v1/migration/dia
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{admin_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="excel_migration_sample_DIA.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./test-data/excel_migration_sample_DIA.xlsx
------WebKitFormBoundary7MA4YWxkTrZu0gW--


### ===============================================
### [PART 2] 기타 기능 테스트
### ===============================================

### -----------------------------------------------
### 사용자 관리 API
### -----------------------------------------------
### U-1. 내 정보 조회
GET http://localhost:8080/api/v1/users/me
Authorization: Bearer {{therapist_token}}

### U-2. 내 정보 수정
PUT http://localhost:8080/api/v1/users/me
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "name": "김치료잘함"
}

### -----------------------------------------------
### 치료사 관리 API (Admin Only)
### -----------------------------------------------
### T-1. 치료사 목록 조회
GET http://localhost:8080/api/v1/therapists
Authorization: Bearer {{admin_token}}

### T-2. 치료사 상세 조회
GET http://localhost:8080/api/v1/therapists/{{therapist_id}}
Authorization: Bearer {{admin_token}}

### T-3. 치료사 정보 수정
PUT http://localhost:8080/api/v1/therapists/{{therapist_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "specialty": "ABA 및 언어치료",
  "experienceYears": 5
}

### T-4. 추가 치료사 등록용 사용자 생성
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "email": "therapist6@gmail.com",
  "password": "therapist1234",
  "name": "박치료후보",
  "role": "THERAPIST",
  "inviteCode": "ABA20262"
}

### T-5. 새 치료사 로그인 (User ID 확인)
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "therapist6@gmail.com",
  "password": "therapist1234"
}
> {%
    client.global.set("new_therapist_token", response.body.data.accessToken);
%}

### T-6. 새 치료사 User ID 조회
GET http://localhost:8080/api/v1/users/me
Authorization: Bearer {{new_therapist_token}}

> {%
    client.global.set("new_therapist_user_id", response.body.data.id);
    client.log("New Therapist User ID: " + response.body.data.id);
%}

### T-6-1 새 치료사 정보 조회 (User ID로 Therapist ID획득)
GET http://localhost:8080/api/v1/therapists/by-user/{{new_therapist_user_id}}
Authorization: Bearer {{admin_token}}

> {%
    client.global.set("new_therapist_id", response.body.data.id);
    client.log("New Therapist ID saved: " + response.body.data.id);
%}


### T-7. 새 치료사 정보 수정 (전문분야, 경력)
PUT http://localhost:8080/api/v1/therapists/{{new_therapist_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "specialty": "언어치료",
  "experienceYears": 20
}

### T-8. 치료사 삭제 (Soft Delete)
# 주의: 실행하면 치료사가 비활성화됩니다.
DELETE http://localhost:8080/api/v1/therapists/{{new_therapist_id}}
Authorization: Bearer {{admin_token}}

### -----------------------------------------------
### 아동 관리 API
### -----------------------------------------------
### C-1. 아동 목록 조회
GET http://localhost:8080/api/v1/children
Authorization: Bearer {{therapist_token}}

### C-2. 아동 상세 조회
GET http://localhost:8080/api/v1/children/{{child_id}}
Authorization: Bearer {{therapist_token}}

### C-3. 아동 정보 수정 (Admin Only)
PUT http://localhost:8080/api/v1/children/{{child_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "김철수파이팅",
  "diagnosis": "자폐 스펙트럼 장애 (ASD) - 경증",
  "currentDevLevel": "눈 맞춤 개선 중, 호명 반응 향상"
}

### C-4. 추가 아동 등록
POST http://localhost:8080/api/v1/children
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "김영희",
  "birthDate": "2019-08-20",
  "gender": "FEMALE",
  "diagnosis": "발달 지연",
  "currentDevLevel": "전반적인 발달 지연",
  "parentCharacteristics": "치료에 적극적",
  "requestDetails": "의사소통 능력 향상",
  "therapistId": {{therapist_id}}
}
> {%
    client.global.set("child_id_2", response.body.data);
%}

### -----------------------------------------------
### 목표 관리 API
### -----------------------------------------------
### G-1. 목표 목록 조회
GET http://localhost:8080/api/v1/children/{{child_id}}/goals
Authorization: Bearer {{therapist_token}}

### G-2. 목표 상세 조회
GET http://localhost:8080/api/v1/goals/{{goal_id}}
Authorization: Bearer {{therapist_token}}

### G-3. 목표 수정
PUT http://localhost:8080/api/v1/goals/{{goal_id}}
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "name": "이름 부르면 눈 맞추기 (수정됨)",
  "status": "IN_PROGRESS",
  "targetSuccessRate": 85
}

### G-4. 추가 목표 생성
POST http://localhost:8080/api/v1/children/{{child_id}}/goals
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "name": "간단한 지시 따르기",
  "category": "COMMUNICATION",
  "description": "앉아, 일어서 등 간단한 지시에 반응하기",
  "targetSuccessRate": 70,
  "consecutiveDays": 5
}
> {%
    client.global.set("goal_id_2", response.body.data);
%}

### -----------------------------------------------
### 세션 관리 API
### -----------------------------------------------
### S-1. 세션 목록 조회 (기간 필터링)
GET http://localhost:8080/api/v1/sessions?childId={{child_id}}&startDate=2026-02-01&endDate=2026-02-28
Authorization: Bearer {{therapist_token}}

### S-2. 세션 상세 조회
GET http://localhost:8080/api/v1/sessions/{{session_id}}
Authorization: Bearer {{therapist_token}}

### S-3. 추가 세션 생성 (다중 시행)
POST http://localhost:8080/api/v1/sessions
Content-Type: application/json
Authorization: Bearer {{therapist_token}}

{
  "childId": {{child_id}},
  "therapistId": {{therapist_id}},
  "sessionDate": "2026-02-06",
  "duration": 45,
  "notes": "세 번째 세션. 복수 목표 진행.",
  "trials": [
    {
      "goalId": {{goal_id}},
      "taskContent": "눈 맞춤 훈련",
      "trials": 15,
      "successes": 11,
      "promptCount": 2,
      "memo": "제스처 촉구 감소"
    },
    {
      "goalId": {{goal_id_2}},
      "taskContent": "앉아 지시 따르기",
      "trials": 10,
      "successes": 7,
      "promptCount": 3,
      "memo": "신체적 촉구 필요"
    }
  ]
}

### -----------------------------------------------
### 리포트 관리 API
### -----------------------------------------------
### R-1. 리포트 목록 조회
GET http://localhost:8080/api/v1/reports?childId={{child_id}}
Authorization: Bearer {{therapist_token}}

### R-2. 리포트 상세 조회
GET http://localhost:8080/api/v1/reports/{{report_id}}
Authorization: Bearer {{therapist_token}}

### -----------------------------------------------
### 이미지 마이그레이션 API (Vision AI)
### -----------------------------------------------
### I-1. 이미지 마이그레이션 테스트
# OPENAI_API_KEY 환경변수가 필요합니다.
POST http://localhost:8080/api/v1/migration/image
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{admin_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="migration_image_ex1.jpeg"
Content-Type: image/jpeg

< ./test-data/migration_image_ex1.jpeg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### -----------------------------------------------
### 부모 계정 테스트
### -----------------------------------------------
### P-1. 부모 회원가입
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "email": "parent2@gmail.com",
  "password": "parent1234",
  "name": "김부모",
  "role": "PARENT",
  "inviteCode": "ABA20262"
}

### P-2. 부모 로그인
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "parent2@gmail.com",
  "password": "parent1234"
}
> {%
    client.global.set("parent_token", response.body.data.accessToken);
%}


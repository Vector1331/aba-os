# ===============================================
# ABA-OS API 테스트 파일
# ===============================================
#
# Swagger UI 접속 URL:
# http://localhost:8080/swagger-ui/index.html
#
# OpenAPI 문서 (JSON):
# http://localhost:8080/v3/api-docs
#
# ===============================================
#
# ** 테스트 계정 (서버 실행 시 자동 생성) **
# ----------------------------------------
# Admin:     admin@aba.com / 1234
# Therapist: teacher@aba.com / 1234
# Parent:    parent@aba.com / 1234
# ----------------------------------------
#
# ** 테스트 ID (고정) **
# Center ID:         00000000-0000-0000-0000-000000000001
# Admin User ID:     00000000-0000-0000-0000-000000000010
# Therapist User ID: 00000000-0000-0000-0000-000000000011
# Therapist ID:      00000000-0000-0000-0000-000000000001
# Parent User ID:    00000000-0000-0000-0000-000000000012
# Child ID:          00000000-0000-0000-0000-000000000001
#
# ===============================================

### ===============================================
### 치료사 관리 API 테스트 (Admin Only)
### ===============================================

### T-1. Admin 로그인 (토큰 획득용)
# 치료사 관리 API는 Admin 권한이 필요합니다.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@aba.com",
  "password": "1234"
}
> {%
    client.global.set("admin_token", response.body.data.accessToken);
    client.log("Admin Token saved!");
%}

### T-2. 치료사 목록 조회 (Get Therapist List)
# 센터에 소속된 모든 치료사 목록을 조회합니다.
GET http://localhost:8080/api/v1/therapists
Authorization: Bearer {{admin_token}}

### T-3. 치료사 상세 조회 (Get Therapist Detail)
# 특정 치료사의 상세 정보를 조회합니다.
GET http://localhost:8080/api/v1/therapists/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{admin_token}}

### T-4. 새 사용자 회원가입 (치료사 등록 준비)
# 치료사를 등록하려면 먼저 User가 필요합니다.
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "email": "newtherapist@aba.com",
  "password": "1234",
  "name": "박치료",
  "role": "THERAPIST",
  "inviteCode": "TEST1234"
}

### T-5. 새로 가입한 사용자로 로그인 (User ID 확인용)
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "newtherapist@aba.com",
  "password": "1234"
}
> {%
    // 새 사용자의 정보를 확인하려면 /users/me 호출 필요
    client.global.set("new_therapist_token", response.body.data.accessToken);
%}

### T-5-1. 새 사용자 정보 조회 (User ID 획득)
GET http://localhost:8080/api/v1/users/me
Authorization: Bearer {{new_therapist_token}}

> {%
    // 응답에서 userId를 저장 (수동으로 복사해서 T-6에 사용)
    client.log("New User ID: " + response.body.data.id);
%}

### T-6. 치료사 등록 (Create Therapist)
# 위에서 생성한 사용자를 치료사로 등록합니다.
# ⚠️ 주의: userId에 T-5-1에서 얻은 사용자 ID를 넣으세요.
POST http://localhost:8080/api/v1/therapists
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "userId": "여기에_T-5-1에서_얻은_userId_입력",
  "specialty": "언어치료",
  "experienceYears": 5
}
> {%
    client.global.set("new_therapist_id", response.body.data);
    client.log("New Therapist ID: " + response.body.data);
%}

### T-7. 치료사 정보 수정 (Update Therapist)
# 치료사의 전문분야, 경력 등을 수정합니다.
PUT http://localhost:8080/api/v1/therapists/{{new_therapist_id}}
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "specialty": "ABA 및 언어치료",
  "experienceYears": 6
}

### T-8. 수정된 치료사 상세 조회
GET http://localhost:8080/api/v1/therapists/{{new_therapist_id}}
Authorization: Bearer {{admin_token}}

### T-9. 치료사 삭제 (Delete Therapist - Soft Delete)
# ⚠️ 주의: 실행하면 치료사가 삭제(비활성화)됩니다.
DELETE http://localhost:8080/api/v1/therapists/{{new_therapist_id}}
Authorization: Bearer {{admin_token}}

### T-10. 삭제 후 치료사 목록 조회 (삭제된 치료사 미포함 확인)
GET http://localhost:8080/api/v1/therapists
Authorization: Bearer {{admin_token}}

### ===============================================
### 기존 테스트 (아래부터)
### ===============================================

### 1. 회원가입 요청 (Register)
# 설명: 초대코드(ABA2026)를 이용해 치료사 계정을 생성합니다.
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "email": "therapist@test.com",
  "password": "password123!",
  "name": "김치료",
  "role": "THERAPIST",
  "inviteCode": "ABA2026"
}

### 2. 로그인 요청 (Login)
# 설명: 위에서 만든 계정으로 로그인하여 JWT 토큰을 받습니다.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "therapist@test.com",
  "password": "password123!"
}

### 3. 관리자 회원가입 (Admin Register)
# 설명: role을 'ADMIN'으로 설정하여 관리자 계정을 생성합니다.
POST http://localhost:8080/api/v1/auth/register
Content-Type: application/json

{
  "email": "admin@aba.com",
  "password": "admin1234!",
  "name": "관리자",
  "role": "ADMIN",
  "inviteCode": "ABA2026"
}

### 4. 관리자 로그인 (Admin Login)
# 설명: 관리자 토큰을 발급받습니다. (아동 등록 시 필요)&& 응답에서 accessToken을 꺼내서 'auth_token'이라는 변수에 저장
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@aba.com",
  "password": "admin1234!"
}
> {%
    client.global.set("auth_token", response.body.data.accessToken);
%}

### 5. 아동 등록 (Create Child) - Admin Only
# ⚠️ 주의: Header에 '관리자 accessToekn 토큰'을 넣어야 합니다.
# ⚠️ 주의: "therapistId"에 위에서 조회한 UUID를 꼭 넣으세요!
POST http://localhost:8080/api/v1/children
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "김영희",
  "birthDate": "2020-05-05",
  "gender": "FEMALE",
  "diagnosis": "자폐 스펙트럼 장애 (ASD)",
  "currentDevLevel": "눈 맞춤이 어렵고 발화가 제한적임",
  "parentCharacteristics": "가정 연계 치료에 적극적임",
  "requestDetails": "이름 호명 반응 개선 희망",
  "therapistId": "3391df24-f382-4736-95b7-74f2ba73b09b"
}

### 6. 치료사 로그인 (Therapist Login)
# 설명: 다시 치료사로 로그인해서 내 담당 아동을 조회합니다.
POST http://localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "therapist@test.com",
  "password": "password123!"
}
> {%
    client.global.set("auth_token", response.body.data.accessToken);
%}

### 7. 아동 목록 조회 (List Children)
# 설명: 치료사가 담당하는 아동 목록을 가져옵니다.
GET http://localhost:8080/api/v1/children
Authorization: Bearer {{auth_token}}

> {%
    client.global.set("child_id", response.body.data[0].id);
    client.log("Child ID saved: " + client.global.get("child_id"));
%}

### 8. 목표 생성 (Create Goal)
# ⚠️ 주의: URL의 {childId} 자리에 위 목록 조회에서 나온 아동 ID를 넣으세요.
POST http://localhost:8080/api/v1/children/{{child_id}}/goals
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "5분간 한 가지 일에 집중 ",
  "category": "SOCIAL",
  "description": "치료사가 떨어져 있어도 5분간 한 가지 일에 집중",
  "targetSuccessRate": 60,
  "consecutiveDays": 5,
  "promptPlan": "언어적 촉구(Verbal) -> 제스처(Gestural) -> 소거"
}

### 9. 목표 목록 조회 (List Goals)
GET http://localhost:8080/api/v1/children/{{child_id}}/goals
Authorization: Bearer {{auth_token}}

> {%
    // 첫 번째 목표의 ID를 'goal_id' 변수에 저장.
    client.global.set("goal_id", response.body.data[0].id);
    client.log("Goal ID saved: " + client.global.get("goal_id"));
%}

### 10.세션 생성(Create Session)
POST http://localhost:8080/api/v1/sessions
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "childId": "{{child_id}}",
  "therapistId": "3391df24-f382-4736-95b7-74f2ba73b09b",
  "sessionDate": "2026-02-01",
  "duration": 50,
  "notes": "두번째 세션 진행. 아이의 컨디션이 그닥 좋지않음.",
  "trials": [
    {
      "goalId": "{{goal_id}}",
      "trials": 12,
      "successes": 8,
      "promptType": "VERBAL"
    },
    {
      "goalId": "{{goal_id}}",
      "trials": 14,
      "successes": 5,
      "promptType": "NONE"
    }
  ]
}

> {%
    client.global.set("session_id", response.body.data);
    client.log("Session ID saved: " + response.body.data);
%}

### 11. 세션 목록 조회 (Get Session List)
GET http://localhost:8080/api/v1/sessions?childId={{child_id}}
Authorization: Bearer {{auth_token}}

### 12. 세션 상세 조회 (Get Session Detail)
GET http://localhost:8080/api/v1/sessions/{{session_id}}
Authorization: Bearer {{auth_token}}

### 13. 리포트 생성 - AI 부모용 요약 (Create Report - PARENT_SUMMARY)
# reportType: PARENT_SUMMARY (AI 생성), STATISTICS_ONLY (통계만)
# AI API 키가 없으면 더미 데이터가 생성됩니다.
POST http://localhost:8080/api/v1/reports
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "childId": "{{child_id}}",
  "title": "2026년 2월 발달 리포트 (AI)",
  "periodStart": "2026-02-01",
  "periodEnd": "2026-02-28",
  "reportType": "PARENT_SUMMARY"
}

> {%
    // 생성된 리포트 ID를 저장합니다.
    client.global.set("report_id", response.body.data.id);
    client.log("Report ID saved: " + response.body.data.id);
%}

### 13-1. 리포트 생성 - 통계만 (Create Report - STATISTICS_ONLY)
# AI 없이 통계 데이터만 생성
POST http://localhost:8080/api/v1/reports
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "childId": "{{child_id}}",
  "title": "2026년 2월 통계 리포트",
  "periodStart": "2026-02-01",
  "periodEnd": "2026-02-28",
  "reportType": "STATISTICS_ONLY"
}

### 14. 리포트 목록 조회 (Get Report List)
GET http://localhost:8080/api/v1/reports?childId={{child_id}}
Authorization: Bearer {{auth_token}}

### 15. 리포트 상세 조회 (Get Report Detail)
# 통계(총 세션, 시도, 정확도)와 content(AI 템플릿 문구)를 확인하세요.
GET http://localhost:8080/api/v1/reports/{{report_id}}
Authorization: Bearer {{auth_token}}

### 16. 대시보드 요약 조회 (Dashboard Summary)
# 센터별 활성 아동 수, 오늘/이번 달 세션 수, 예정 세션 목록을 조회합니다.
GET http://localhost:8080/api/v1/dashboard/summary
Authorization: Bearer {{auth_token}}

### 17. 엑셀 데이터 마이그레이션 (Excel Upload) - Admin Only
# 테스트 엑셀 데이터
#    - Sheet 1 (Children): Name, BirthDate(yyyy-MM-dd), Gender(M/F), Diagnosis
#    - Sheet 2 (Goals): ChildName, GoalContent, Category

POST http://localhost:8080/api/v1/migration/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{auth_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="migration_data.xlsx"
Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

< ./test-data/migration_data.xlsx
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 18. 이미지 기반 데이터 마이그레이션 (Vision AI) - Admin Only
# 수기 기록지 이미지를 업로드하면 Vision AI가 아동 정보와 치료 목표를 자동으로 추출합니다.
# No-Storage Strategy: 이미지는 서버에 저장되지 않고 메모리에서 처리 후 즉시 삭제됩니다.
# 지원 형식: JPEG, PNG, WebP, GIF (최대 20MB)
# OPENAI_API_KEY 환경변수가 설정되어 있거나 설정파일에 저장되어 있어야 합니다.

### 18-1. 이미지 마이그레이션 테스트 1 (예시 이미지 1)
POST http://localhost:8080/api/v1/migration/image
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{auth_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="migration_image_ex1.jpeg"
Content-Type: image/jpeg

< ./test-data/migration_image_ex1.jpeg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 18-2. 이미지 마이그레이션 테스트 2 (예시 이미지 2)
POST http://localhost:8080/api/v1/migration/image
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{auth_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="migration_image_ex2.jpeg"
Content-Type: image/jpeg

< ./test-data/migration_image_ex2.jpeg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 18-3. 이미지 마이그레이션 테스트 3 (예시 이미지 3)
POST http://localhost:8080/api/v1/migration/image
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{auth_token}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="migration_image_ex3.jpeg"
Content-Type: image/jpeg

< ./test-data/migration_image_ex3.jpeg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### ===============================================
### 아래는 수정/삭제 API (Missing API)
### ===============================================

### 19. 내 정보 조회 (Get My Profile)
GET http://localhost:8080/api/v1/users/me
Authorization: Bearer {{auth_token}}

### 20. 내 정보 수정 (Update My Profile)
PUT http://localhost:8080/api/v1/users/me
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "김치료사(수정됨)"
}

### 21. 아동 정보 수정 (Update Child) - Admin Only
# 먼저 4번(Admin Login)을 실행해서 admin 토큰을 받으세요.
PUT http://localhost:8080/api/v1/children/{{child_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "김영희(수정)",
  "diagnosis": "자폐 스펙트럼 장애 (ASD) - 경증",
  "currentDevLevel": "눈 맞춤 개선 중, 단어 발화 증가"
}

### 22. 목표 상세 조회 (Get Goal Detail)
GET http://localhost:8080/api/v1/goals/{{goal_id}}
Authorization: Bearer {{auth_token}}

### 23. 목표 수정 (Update Goal)
PUT http://localhost:8080/api/v1/goals/{{goal_id}}
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "5분간 한 가지 일에 집중 (수정됨)",
  "status": "IN_PROGRESS",
  "targetSuccessRate": 70
}

### 24. 목표 삭제 (Delete Goal)
# ⚠️ 주의: 실행하면 목표가 삭제됩니다.
DELETE http://localhost:8080/api/v1/goals/{{goal_id}}
Authorization: Bearer {{auth_token}}

### 25. 세션 삭제 (Delete Session)
# ⚠️ 주의: 실행하면 세션과 시행 기록이 함께 삭제됩니다.
DELETE http://localhost:8080/api/v1/sessions/{{session_id}}
Authorization: Bearer {{auth_token}}

### 26. 리포트 삭제 (Delete Report)
# ⚠️ 주의: 실행하면 리포트가 삭제됩니다.
DELETE http://localhost:8080/api/v1/reports/{{report_id}}
Authorization: Bearer {{auth_token}}

### 27. 아동 삭제 (Delete Child) - Admin Only
# ⚠️ 주의: 실행하면 아동과 연관된 모든 데이터(목표, 세션)가 삭제됩니다.
# 먼저 4번(Admin Login)을 실행해서 admin 토큰을 받으세요.
DELETE http://localhost:8080/api/v1/children/{{child_id}}
Authorization: Bearer {{auth_token}}

